# Live presence (Supabase Realtime). Copy this file to .env.local for local development.
# On GitHub, set the same two values as repository *variables* (Settings → Secrets and variables
# → Actions → Variables) named SUPABASE_URL and SUPABASE_KEY.
#
# Use ONLY the public "anon" / "publishable" key. Never a secret or service_role key:
# everything here ends up in the public website. The build refuses secret keys.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
